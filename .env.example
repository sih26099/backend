# Copy this file to .env and adjust as needed. All values shown are the defaults.

DATABASE_URL=sqlite:///./sih26099.db

# --- Hybrid matching weights (must sum to 1.0) ---
WEIGHT_LEXICAL=0.25
WEIGHT_SEMANTIC=0.35
WEIGHT_TECHNICAL=0.40

# --- Match classification thresholds (0-1 scale) ---
THRESHOLD_EXACT_DUPLICATE=0.97
THRESHOLD_NEAR_DUPLICATE=0.90
THRESHOLD_FUNCTIONALLY_EQUIVALENT=0.75
THRESHOLD_POSSIBLE_MATCH=0.55

# --- Attribute comparison tolerance ---
SIZE_TOLERANCE_MM=0.5

# --- Matching behavior ---
MIN_CONFIDENCE_TO_STORE=0.50
CROSS_CPSE_ONLY=true
